MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change_me_secure_password
MONGO_DB_NAME=eticketing

# JWT secret used by backend to sign tokens. Replace with a long random value.
JWT_SECRET=replace_with_a_secure_random_string

# Spring profile
SPRING_PROFILES_ACTIVE=prod

# Host port to bind frontend to on the EC2 host. Use 80 for standard HTTP or change if 80 is taken.
FRONTEND_HOST_PORT=80
MONGO_INITDB_ROOT_USERNAME=eticketing
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_DB_NAME=eticketing
JWT_SECRET=change-this-to-a-long-random-secret
SPRING_PROFILES_ACTIVE=prod
