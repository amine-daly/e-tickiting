{
    "name": "e-ticketing-monorepo",
    "private": true,
    "workspaces": [
        "apps/safra"
    ],
    "scripts": {
        "format": "echo format placeholder",
        "lint": "echo lint placeholder",
        "test": "echo test placeholder",
        "start": "npm --prefix apps/terminal run start -- --open",
